# Copy this file to .env and fill in your bot token from
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# MongoDB Atlas connection string (Atlas -> your cluster -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name (optional)
MONGODB_DB=karaama-bot

# Command prefix
PREFIX=?

# Port for the /health web server (Render sets this automatically)
PORT=3000
